4
(
    cylinder
    {
        type            wall;
        inGroups        1(wall);
        nFaces          40;
        startFace       760;
    }
    front
    {
        type            empty;
        inGroups        1(empty);
        nFaces          400;
        startFace       800;
    }
    back
    {
        type            empty;
        inGroups        1(empty);
        nFaces          400;
        startFace       1200;
    }
    defaultFaces
    {
        type            empty;
        inGroups        1(empty);
        nFaces          40;
        startFace       1600;
    }
